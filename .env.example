PORT=4000
MONGO_DB_URL=mongodb://localhost:27017/invoicedb
# JWT signing secret - use a long random string
SECRET=change-me
# Comma-separated list of allowed frontend origins (leave empty to allow all in dev)
CORS_ORIGIN=http://localhost:3000

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# Groq key for the invoice assistant. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Free RabbitMQ from https://www.cloudamqp.com (Little Lemur plan)
RABBITMQ_URL=

# Free Redis. Use rediss:// for Upstash, or redis://127.0.0.1:6379 for local Docker.
REDIS_URL=
ASSISTANT_CACHE_TTL_SECONDS=120

# Free Gemini embedding key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768
VECTOR_INDEX_NAME=invoice_note_vector
